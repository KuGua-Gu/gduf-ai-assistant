# 大模型接口（OpenAI 兼容协议，二选一填写即可）
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1        LLM_MODEL=deepseek-chat
# 智谱 GLM:  LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-5.3-flash
# 通义千问:  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# 视觉 / OCR 模型（成员4使用，Agent 仅透传 image_id）
# DeepSeek 文本模型不支持图片，需单独填写多模态模型，例如：
# 通义千问: VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  VISION_MODEL=qwen-vl-plus
# 智谱 GLM:  VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4                VISION_MODEL=glm-5.3-flash
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=

# OCR 上传（成员4）
OCR_UPLOAD_DIR=data/uploads
OCR_MAX_BYTES=10485760

# 服务配置
DB_PATH=data/app.db
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

# Agent 行为参数
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
AGENT_MAX_TOOL_CALLS=4
AGENT_MEMORY_WINDOW=8
